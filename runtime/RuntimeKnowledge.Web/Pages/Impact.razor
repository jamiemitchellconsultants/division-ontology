@page "/impact"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject WorkspaceClient Api

<h1>Impact assessment</h1>

<form @onsubmit="Search" @onsubmit:preventDefault>
    <label for="impact-query">Change request description</label>
    <input id="impact-query" type="search" required @bind="query" />
    <button type="submit" disabled="@busy">Search</button>
</form>
@if (message is not null) { <p role="alert">@message</p> }
<ApiError Error="error" ReturnRoute="impact" />

@if (leads.Count > 0)
{
    <section aria-labelledby="impact-leads-heading">
        <h2 id="impact-leads-heading">Leads</h2>
        <p>Snapshot <code>@snapshotId</code></p>
        <ImpactLeadList Leads="leads" Selected="selected" OnToggle="Toggle" />
        <div class="actions">
            @if (nextCursor is not null) { <button type="button" disabled="@busy" @onclick="LoadMore">Load more</button> }
            <button type="button" disabled="@(busy || selected.Count == 0)" @onclick="Trace">Trace impact</button>
        </div>
    </section>
}

@if (paths is not null)
{
    <section aria-labelledby="impact-paths-heading">
        <h2 id="impact-paths-heading">Impact paths</h2>
        <ImpactPathList Paths="paths.Paths" />
    </section>
    <GapList Gaps="paths.Gaps" />
}
else if (searchGaps is not null)
{
    <GapList Gaps="searchGaps" />
}

@code {
    private string query = "";
    private string? searchedQuery, snapshotId, nextCursor, message;
    private readonly List<ImpactLead> leads = [];
    private readonly HashSet<ImpactKey> selected = [];
    private IReadOnlyList<ImpactGap>? searchGaps;
    private ImpactPathsResult? paths;
    private WorkspaceApiException? error;
    private bool busy;

    private Task Search()
    {
        Clear();
        searchedQuery = query;
        return Run(async () => Show(await Api.ImpactSearch(new ImpactSearchRequest(searchedQuery, null))));
    }

    private Task LoadMore() =>
        Run(async () => Show(await Api.ImpactSearch(new ImpactSearchRequest(searchedQuery, null, snapshotId, nextCursor))));

    private Task Trace() =>
        Run(async () => paths = await Api.ImpactPaths(new ImpactPathsRequest(snapshotId!, selected.ToList())));

    private void Toggle(ImpactKey key)
    {
        if (!selected.Remove(key)) selected.Add(key);
    }

    private void Show(ImpactSearchResult page)
    {
        snapshotId ??= page.SnapshotId;
        leads.AddRange(page.Leads);
        nextCursor = page.NextCursor;
        searchGaps = page.Gaps;
    }

    private void Clear()
    {
        leads.Clear();
        selected.Clear();
        snapshotId = nextCursor = message = null;
        searchGaps = null;
        paths = null;
        error = null;
    }

    private async Task Run(Func<Task> call)
    {
        if (busy) return;
        busy = true;
        error = null;
        try { await call(); }
        catch (WorkspaceApiException problem) when (problem.Code == "snapshotChanged")
        {
            Clear();
            message = problem.Message;
        }
        catch (WorkspaceApiException problem) { error = problem; }
        finally { busy = false; }
    }
}
