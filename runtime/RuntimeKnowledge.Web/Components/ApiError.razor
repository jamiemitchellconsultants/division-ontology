@inject NavigationManager Navigation

@if (Error is not null)
{
    <p role="alert">
        @if (Error.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            <button type="button" @onclick="SignIn">Sign in again</button>
            <span> to continue.</span>
        }
        else
        {
            @Error.Message
        }
    </p>
}

@code {
    [Parameter] public WorkspaceApiException? Error { get; set; }
    [Parameter] public string? ReturnRoute { get; set; }

    private void SignIn()
    {
        var baseUri = new Uri(Navigation.BaseUri);
        var returnUrl = ReturnRoute is not null && Uri.TryCreate(baseUri, ReturnRoute, out var absolute) &&
            baseUri.IsBaseOf(absolute) && string.IsNullOrEmpty(absolute.UserInfo) ? absolute.AbsoluteUri : Navigation.Uri;
        Navigation.NavigateToLogin("authentication/login",
            new InteractiveRequestOptions { Interaction = InteractionType.SignIn, ReturnUrl = returnUrl });
    }
}
