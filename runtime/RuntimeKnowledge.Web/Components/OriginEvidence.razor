@if (Origin is { } origin)
{
    <div class="origin">
        <p><strong>@Label</strong> · @origin.Key.SourceId · <code>@origin.Key.Identifier</code></p>
        <p>Source commit <code>@origin.SourceCommit</code> · Snapshot <code>@origin.SnapshotId</code></p>
        @if (!string.IsNullOrWhiteSpace(origin.Basis)) { <p>Basis @origin.Basis</p> }
        @if (origin.Evidence.Count > 0)
        {
            <ul aria-label="Source evidence">
                @foreach (var evidence in origin.Evidence)
                {
                    <li>
                        <code>@evidence.Path</code> lines @evidence.StartLine–@evidence.EndLine (@evidence.Role) · <code>@evidence.BlobId</code>
                        @if (Repositories is { } repositories)
                        {
                            @if (GraphEvidenceLinks.TryCreate(repositories.Map, origin, evidence) is { } link)
                            {
                                <a href="@link.AbsoluteUri" target="_blank" rel="noopener">View evidence</a>
                            }
                            else
                            {
                                <span> · Evidence link unavailable</span>
                            }
                        }
                    </li>
                }
            </ul>
        }
        else if (Repositories is not null)
        {
            <p>No source evidence link is available.</p>
        }
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = "Published origin";
    [Parameter] public Provenance? Origin { get; set; }
    [Parameter] public GraphEvidenceRepositories? Repositories { get; set; }
}
