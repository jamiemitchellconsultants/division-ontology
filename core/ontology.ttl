@prefix : <https://github.com/jamiemitchellconsultants/division-ontology#> .
@prefix kit: <https://ontology-kit.dev/schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:_meta a owl:Ontology ;
    owl:versionInfo "0.2.0" .

:StaffId a owl:Class ;
    rdfs:subClassOf kit:ValueObject ;
    rdfs:label "StaffId" ;
    rdfs:comment "The enterprise-wide staff number issued by the HR system and used as the internal primary key by older enterprise systems. Exactly 7 characters: U or N followed by 6 digits, case-insensitive and normalised to uppercase. Unique per member of staff, never reissued and never changed. The identity provider is its source of truth; applications read it from a token claim and do not edit it." .

# Scope and source evidence for the following shared knowledge concepts:
# docs/features/runtime-knowledge-workspace/01-vision.md, outcomes 1, 2 and 5;
# docs/features/runtime-knowledge-workspace/02-behaviours.md, Terms and U4–U5.
# These definitions add no equivalence links and change no existing term meaning.

:PublishedKnowledgeSnapshot a owl:Class ;
    rdfs:label "PublishedKnowledgeSnapshot" ;
    rdfs:comment "An identifiable published baseline of source-owned knowledge, recording the participating source revisions against which entities and relationships are resolved." .

:KnowledgeAnnotation a owl:Class ;
    rdfs:label "KnowledgeAnnotation" ;
    rdfs:comment "Persistent human-authored context attached to an identified published entity, such as a business explanation, way of working or descriptive business RBAC information; it retains runtime provenance." .

:RuntimeRelationship a owl:Class ;
    rdfs:label "RuntimeRelationship" ;
    rdfs:comment "A persistent human-authored relationship between identified published entities, with stated meaning and runtime provenance, usable independently of repository codification." .

:KnowledgeContributionChange a owl:Class ;
    rdfs:label "KnowledgeContributionChange" ;
    rdfs:comment "A retained record of a successful creation, edit or removal of a runtime annotation or relationship, preserving its identity, acting user, time and affected content and provenance." .

:CodificationAssociation a owl:Class ;
    rdfs:label "CodificationAssociation" ;
    rdfs:comment "An explicitly recorded association identifying a published relationship as a codification of a runtime relationship while preserving both records and their provenance. It is not an equivalence assertion between endpoint entities." .
