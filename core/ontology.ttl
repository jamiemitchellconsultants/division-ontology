@prefix : <https://github.com/jamiemitchellconsultants/division-ontology#> .
@prefix kit: <https://ontology-kit.dev/schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:_meta a owl:Ontology ;
    owl:versionInfo "0.5.1" .

# Scope and source evidence for the following traversal paging concepts:
# docs/features/traversal-cursor-pagination/01-vision.md, outcomes 1, 4 and 6;
# docs/features/traversal-cursor-pagination/02-behaviours.md, Terms.
# These definitions add no equivalence links and change no existing term meaning.

:TraversalCursor a owl:Class ;
    rdfs:label "TraversalCursor" ;
    rdfs:comment "An opaque continuation token issued with a non-final page of a graph traversal. It binds the traversal's start, direction, depth and unavailable-endpoint option, the published knowledge snapshot it was issued under, and the workspace journal position at issue. Submitting it to the same traversal continues the walk; it is not meaningful for any other traversal." .

:TraversalPage a owl:Class ;
    rdfs:label "TraversalPage" ;
    rdfs:comment "One bounded page of a graph traversal result, together with the entity context for the endpoints appearing in its paths. A non-final page carries a traversal cursor and reports truncation; the final page carries neither." .

:StaffId a owl:Class ;
    rdfs:subClassOf kit:ValueObject ;
    rdfs:label "StaffId" ;
    rdfs:comment "The enterprise-wide staff number issued by the HR system and used as the internal primary key by older enterprise systems. Exactly 7 characters: U or N followed by 6 digits, case-insensitive and normalised to uppercase. Unique per member of staff, never reissued and never changed. The identity provider is its source of truth; applications read it from a token claim and do not edit it." .

# Scope and source evidence for the following shared knowledge concepts:
# docs/features/runtime-knowledge-workspace/01-vision.md, outcomes 1, 2 and 5;
# docs/features/runtime-knowledge-workspace/02-behaviours.md, Terms and U4–U5.
# These definitions add no equivalence links and change no existing term meaning.

:PublishedKnowledgeSnapshot a owl:Class ;
    rdfs:label "PublishedKnowledgeSnapshot" ;
    rdfs:comment "An identifiable published baseline of source-owned knowledge, recording the participating source revisions against which entities and relationships are resolved." .

:KnowledgeAnnotation a owl:Class ;
    rdfs:label "KnowledgeAnnotation" ;
    rdfs:comment "Persistent human-authored context attached to an identified published entity, such as a business explanation, way of working or descriptive business RBAC information; it retains runtime provenance." .

:RuntimeRelationship a owl:Class ;
    rdfs:label "RuntimeRelationship" ;
    rdfs:comment "A persistent human-authored relationship between identified published entities, with stated meaning and runtime provenance, usable independently of repository codification." .

:KnowledgeContributionChange a owl:Class ;
    rdfs:label "KnowledgeContributionChange" ;
    rdfs:comment "A retained record of a successful creation, edit or removal of a runtime annotation or relationship, preserving its identity, acting user, time and affected content and provenance." .

:CodificationAssociation a owl:Class ;
    rdfs:label "CodificationAssociation" ;
    rdfs:comment "An explicitly recorded association identifying a published relationship as a codification of a runtime relationship while preserving both records and their provenance. It is not an equivalence assertion between endpoint entities." .

# Scope and source evidence for the following shared C4 and impact concepts:
# docs/features/c4-diagrams-from-source-knowledge-graphs/01-vision.md,
# outcomes 1–4; docs/features/c4-diagrams-from-source-knowledge-graphs/
# 02-behaviours.md, B1–B15 and Terms. These definitions add no equivalence
# links and change no existing term meaning.

:C4Diagram a owl:Class ;
    rdfs:label "C4Diagram" ;
    rdfs:comment "A source-backed architectural view of a selected focus at system-context, container, component or code level, tied to a PublishedKnowledgeSnapshot and showing the evidence and gaps relevant to that view." .

:ImpactAssessment a owl:Class ;
    rdfs:label "ImpactAssessment" ;
    rdfs:comment "An assessor-authored (architect or analyst), reviewable account of the likely effects of a change request across participating sources, identifying assessed elements, reasons, evidence, source revisions, the relationship master list it is pinned to, and unresolved gaps. It does not approve the request." .

# Scope and source evidence for the following shared source-onboarding concepts:
# docs/features/one-action-source-onboarding/01-vision.md, outcomes 1–4;
# docs/features/one-action-source-onboarding/02-behaviours.md, B1–B17 and
# Terms. These definitions add no equivalence links and change no existing
# term meaning.

:SourceAccessGrant a owl:Class ;
    rdfs:label "SourceAccessGrant" ;
    rdfs:comment "A source repository administrator's grant of read-only access to one division's App, which is that owner's consent to import the repository's whole committed ontology into that division's catalog and registers the repository as a source without steward approval." .

:SourceImportConfiguration a owl:Class ;
    rdfs:label "SourceImportConfiguration" ;
    rdfs:comment "Repository-owned committed configuration in a source repository that identifies its ontology path and namespace for import." .

:SourceImportStatus a owl:Class ;
    rdfs:label "SourceImportStatus" ;
    rdfs:comment "The catalog's per-source record of a granted source's state (current, invalid, not configured or access removed), last attempted commit, last published commit and any actionable failure reason." .

# Scope and source evidence for the following generalised impact concepts:
# docs/features/generalise-impact-assessment/01-vision.md, outcomes 1–6;
# docs/features/generalise-impact-assessment/02-behaviours.md, B1–B36 and
# Terms. The ImpactAssessment definition above is corrected from
# architect-authored to assessor-authored by the same evidence. These
# definitions add no equivalence links.

:ImpactLead a owl:Class ;
    rdfs:label "ImpactLead" ;
    rdfs:comment "A graph node or catalog concept returned by candidate search for a change request, identified by source and IRI with how it matched. It is supported when a reviewed C4 mapping or verified evidence backs it. A lead is a starting point to confirm, never a conclusion about impact." .

:ImpactPath a owl:Class ;
    rdfs:label "ImpactPath" ;
    rdfs:comment "An ordered chain of steps from a supported impact lead chosen as a start, each following a source assertion in the impact direction its relationship carries, a reviewed C4 binding, or a reviewed link crossing, and each shown with its evidence. A path never stands as a direct assertion between its endpoints." .

:ReviewedLinkCrossing a owl:Class ;
    rdfs:label "ReviewedLinkCrossing" ;
    rdfs:comment "An impact path step from a node in one source to a node in another, made through the terms they denote and those terms' steward-reviewed links to a shared term. It is permitted for exact links in either direction and for specializes links only from the general term to its specialisations." .

:AssessmentGap a owl:Class ;
    rdfs:label "AssessmentGap" ;
    rdfs:comment "A recorded limit on what a search, impact path trace or impact assessment could establish, with a code and a reason, such as an unlisted relationship, an unlinked term, a missing mapping, unavailable evidence text or a snapshot coverage gap. A gap never states that something is unaffected." .
